public class Main {
    public static void main(String[] args) {

        String s = "santosh anand ghadage";
        String[] words = s.split(" ");
        String result = "";

        for (String word : words) {
            result = result + word.substring(0, 1).toUpperCase()
                    + word.substring(1) + " ";
        }

        System.out.println(result.trim());
    }
}
